---
import { render } from 'astro:content';
import SectionLayout from '@/layouts/SectionLayout.astro';
import ProductCard from '@/components/products/ProductCard.astro';
import CardGrid from '@/components/content/CardGrid.astro';
import { getPage, getProductsByLine } from '@/lib/content';

const page = await getPage('directorybase');
if (!page) throw new Error('Missing DirectoryBase page content entry.');
const entries = await getProductsByLine('directorybase');
const { Content } = await render(page);
---

<SectionLayout title={page.data.seoTitle ?? page.data.title} description={page.data.seoDescription ?? page.data.description} heroTitle={page.data.heroTitle ?? page.data.title} heroSummary={page.data.heroSummary} image={page.data.ogImage}>
  <div class="stack-lg">
    <div class="prose-wrap prose"><Content /></div>
    <CardGrid>
      {entries.map((entry) => <ProductCard entry={entry} />)}
    </CardGrid>
  </div>
</SectionLayout>
