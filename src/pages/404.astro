---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested could not be found.">
  <section class="section-block">
    <div class="container narrow stack-md">
      <h1>Page not found</h1>
      <p class="lede">That page does not exist, or the address has changed.</p>
      <p><a class="button" href="/">Return home</a></p>
    </div>
  </section>
</BaseLayout>
