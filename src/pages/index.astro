---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CardGrid from '@/components/content/CardGrid.astro';
import { getPage } from '@/lib/content';

const page = await getPage('home');
if (!page) throw new Error('Missing home page content entry.');
---

<BaseLayout
  title={page.data.seoTitle ?? page.data.title}
  description={page.data.seoDescription ?? page.data.description}
  image={page.data.ogImage}
>
<section class="hero hero--photo section-block">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="container narrow stack-md hero__content">
    <p class="eyebrow">Gregory Collins</p>
    <h1>
      Technology Explorer.<br />
      Witness to History.<br />
      Systems Architect.
    </h1>
  </div>
</section>

  <section class="section-block home-directions">
    <div class="container stack-md">
      <h2>A million directions start from here</h2>
      <CardGrid>
        <a class="card" href="/photography/"><h3>Photography</h3><p>Selected work, visual stories, and field notes.</p></a>
        <a class="card" href="/writing/"><h3>Writing</h3><p>Essays, books, and practical ideas in public.</p></a>
        <a class="card" href="/lab-in-a-box/"><h3>AI Exploration</h3><p>Practical AI systems, experiments, tools, and structured ideas.</p></a>
        <a class="card" href="/intellectual-property/"><h3>INTELLECTUAL PROPERTY</h3><p>Patents, papers, and foundational technical work.</p></a>
      </CardGrid>
    </div>
  </section>
</BaseLayout>
<style>
  .hero--photo {
    position: relative;
    overflow: hidden;
    min-height: clamp(380px, 54vh, 640px);
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    background: #f5f5f3;
  }

  .hero--photo .hero__bg {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(10, 12, 18, 0.52),
        rgba(10, 12, 18, 0.58)
      ),
      linear-gradient(
        to right,
        rgba(10, 12, 18, 0.20),
        rgba(10, 12, 18, 0.08)
      ),
      url('/images/home/hero-acacia.jpg') center 80% / cover no-repeat;
    filter: saturate(0.78) contrast(0.88) brightness(0.78);
    transform: scale(1.01);
  }

  .hero--photo .hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 10vw, 8rem);
  }

  .hero--photo .eyebrow {
    color: rgba(255, 255, 255, 0.82);
    letter-spacing: 0.14em;
  }

  .hero--photo h1 {
  color: #ffffff;
  max-width: 15ch;
  text-wrap: balance;
}
</style>